<?xml version="1.0" encoding="UTF-8"?>
<!--
    web.xml — Descriptor de despliegue
    Proyecto: Mundial 2026 Goleadores
    Servidor: Apache Tomcat 10.x (Jakarta EE 9+)
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Mundial 2026 - Goleadores</display-name>
    <description>Seguimiento de goleadores del Mundial FIFA 2026</description>

    <!-- ===================================================
         Servlet: GoleadoresServlet
         Devuelve lista de goleadores en JSON
         =================================================== -->
    <servlet>
        <servlet-name>GoleadoresServlet</servlet-name>
        <servlet-class>com.mundial.servlets.GoleadoresServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoleadoresServlet</servlet-name>
        <url-pattern>/GoleadoresServlet</url-pattern>
    </servlet-mapping>

    <!-- ===================================================
         Servlet: JugadorDetalleServlet
         Devuelve perfil completo de un jugador por id
         =================================================== -->
    <servlet>
        <servlet-name>JugadorDetalleServlet</servlet-name>
        <servlet-class>com.mundial.servlets.JugadorDetalleServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>JugadorDetalleServlet</servlet-name>
        <url-pattern>/JugadorDetalleServlet</url-pattern>
    </servlet-mapping>

    <!-- ===================================================
         Página de bienvenida
         =================================================== -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ===================================================
         Configuración de sesión (30 minutos)
         =================================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ===================================================
         Páginas de error
         =================================================== -->
    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>
